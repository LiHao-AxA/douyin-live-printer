# ================= 飞鹅云打印 =================
# 注册: developer.de.feieyun.com 注册开发者账号（免费，需实名认证），
# UKEY 在管理后台 http://admin.feieyun.com/ 个人中心查看
FEIE_USER=your_feie_user
FEIE_UKEY=your_feie_ukey
# 【重要】飞鹅分站：中国站 api.feieyun.cn / 亚太站 api.jp.feieyun.com / 欧洲站 api.de.feieyun.com
# 中国大陆的打印机必须用中国站！配错会表现为"永远离线、任务打印不出"
FEIE_API_BASE=https://api.feieyun.cn/Api/Open/

# ================= 抖音直播小玩法 =================
# 数据推送配置中的签名秘钥（开发者在抖音开放平台配置推送时设置的 secret）
# 本地联调可先填任意字符串，正式接抖音时替换为平台配置的秘钥
DOUYIN_SECRET=douyin-demo-secret
# 时间戳防重放容差（毫秒），默认 300000 = 5 分钟
DOUYIN_TOLERANCE_MS=300000

# ================= 打印机 =================
# 机器底部标签上的 SN 编号
PRINTER_SN=222504796
# 机器底部标签上的 KEY 密钥（绑机必填！飞鹅要求 SN+KEY 一起才能把打印机绑定到你的账号；
# 注意：这是打印机的 KEY，不是开发者账号的 UKEY。标签一般在 SN 旁边）
PRINTER_KEY=your_printer_key
# 总开关：false 则所有事件都不打印
PRINTER_ENABLED=true
# 要打印的事件类型（逗号分隔），官方小玩法支持:
#   live_like 点赞 / live_comment 评论 / live_gift 送礼 / live_fansclub 粉丝团
#   互动工具额外支持 live_follow 关注
PRINT_EVENTS=live_like,live_comment,live_gift,live_fansclub
# 点赞小票冷却时间（毫秒），防止直播间点赞刷屏把打印机打爆
LIKE_COOLDOWN_MS=3000
# 多主播映射（可选）：直播间id → 打印机SN，互动事件按直播间路由到对应打印机；未匹配用 PRINTER_SN
# 格式为 JSON：{"700000001":"222504796","700000002":"222504797"}
PRINTER_ROOM_MAP=

# ================= 服务 =================
# 抖音云 FaaS 平台固定探测 8000 端口（启动超时判定依据），必须监听 8000！
PORT=8000
